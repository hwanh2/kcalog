# backend 실행에 필요한 환경변수 목록.
# 로컬 개발: 이 파일을 .env로 복사하고 값을 채운 뒤 `set -a; source .env; set +a`로 로드하거나
# IDE 실행 구성의 환경변수로 등록한다. (.env는 gitignore 대상)

# --- Database (docker-compose 기본값과 동일, 로컬에선 생략 가능) ---
DB_URL=jdbc:postgresql://localhost:5432/kcalog
DB_USERNAME=kcalog
DB_PASSWORD=kcalog

# --- JWT (운영 필수, 로컬은 기본값 사용 가능. 32바이트 이상) ---
JWT_SECRET=

# --- 카카오 OAuth (developers.kakao.com 앱의 REST API 키 / Client Secret) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 프론트엔드 주소 (OAuth 성공 후 리다이렉트 대상) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- 교차 출처 허용 (운영 필수) ---
# 로컬은 Vite 프록시로 동일 출처라 비워둔다. 운영은 프론트 도메인을 넣는다(콤마 구분).
# 비면 브라우저가 모든 API 응답을 차단해 앱이 통째로 멈춘다. 와일드카드(*)는 쓸 수 없다.
# CORS_ALLOWED_ORIGINS=https://kcalog.site

# --- OpenAI 식사 사진 분석 (platform.openai.com API 키) ---
# 없으면 분석 기능만 에러, 나머지 기능은 정상. 모델·base-url은 선택(기본값 있음)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# --- 사진 Object Storage (S3 호환) ---
# 로컬은 docker-compose MinIO 기본값으로 동작 — 아래는 생략 가능.
# 운영은 S3/R2 접근 정보 필수 (application-prod.yml이 기본값 없이 요구).
# STORAGE_BUCKET=kcalog-photos
# STORAGE_ENDPOINT=http://localhost:9000   # MinIO. AWS S3면 비움, R2면 계정 endpoint
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_PATH_STYLE=true                  # MinIO·R2 true, AWS S3 false

# --- 인증서 (운영 전용 — Traefik이 Let's Encrypt에 등록하는 주소) ---
# 만료 임박 알림을 받는 메일. 로컬에는 필요 없다.
# ACME_EMAIL=

# --- DB 백업 (운영 전용 — deploy/backup.sh가 읽는다) ---
# 사진과 분리된 별도 R2 버킷을 쓴다. 로컬에는 필요 없다.
# BACKUP_BUCKET=kcalog-backups
# BACKUP_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_REGION=auto
# BACKUP_ACCESS_KEY=
# BACKUP_SECRET_KEY=
# BACKUP_RETENTION_DAYS=14
