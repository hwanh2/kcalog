# 모니터링 VM의 ~/kcalog-monitoring/.env 로 복사해 값을 채운다.
# 로컬에서는 .env 없이 그냥 뜬다 (기본값이 로컬용이다).

# Grafana와 Prometheus 화면을 어느 주소에 열지.
# 운영에서는 이 VM의 Tailscale 주소(100.x.x.x)를 준다. 그러면 tailnet 안에서만 보인다.
# 비워두면 루프백이라, 빠뜨렸을 때 열리는 게 아니라 안 열린다.
UI_BIND=100.x.x.x

# Loki를 어느 주소에 열지. 앱 서버의 Alloy가 사설 IP로 보낸다.
LOKI_BIND=10.0.x.x

# Prometheus가 긁어갈 앱 서버의 사설 IP.
# prometheus.yml은 늘 kcalog-backend:8081을 긁고, 그 이름이 이 값을 가리킨다.
BACKEND_IP=10.0.x.x

# Grafana 관리자 비밀번호. 기본값(admin)을 그대로 두지 않는다.
GRAFANA_PASSWORD=

# 알림을 받을 슬랙 Incoming Webhook. api.slack.com/apps 에서 앱을 만들고
# Incoming Webhooks를 켠 뒤 채널을 골라 발급한다.
# 비워 두면 Grafana는 뜨지만 알림이 도착하지 않는다(전송 실패는 Grafana 로그에 남는다).
SLACK_WEBHOOK_URL=

